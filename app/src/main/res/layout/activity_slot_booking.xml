<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/subtle"
    android:orientation="vertical"
    tools:context=".SlotBooking">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient"
        android:elevation="1dp"
        android:padding="16dp"
        android:text="Slot Booking"
        android:textColor="@color/white"
        android:textSize="10pt" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Leg Press"
                android:id="@+id/tvWorkoutTitle"
                android:textSize="8pt" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_gray_stroke_white_bg"
                android:text="Morning"
                android:textColor="@color/black"
                android:id="@+id/btnMorning"/>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_gray_stroke_white_bg"
                android:text="Afternoon"
                android:textColor="@color/black"
                android:id="@+id/btnAfternoon"/>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_gray_stroke_white_bg"
                android:text="Evening"
                android:textColor="@color/black"
                android:id="@+id/btnEvening"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Selected Slots: 0"
                android:textSize="6pt"
                android:id="@+id/tvSelectedSlots"/>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_gray_bg"
                android:text="PROCEED TO NUTRITION"
                android:textColor="@color/black"
                android:id="@+id/btnProceedToNutrition"/>

            <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/rounded_gray_bg"
                android:text="CONFIRM WORKOUT"
                android:textColor="@color/black"
                android:id="@+id/btnConfirmWorkout"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>