<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- White background -->
    <gradient android:startColor="@color/theme" android:endColor="@color/theme_end" android:angle="60"/>

    <!-- Optional white border (not visible on white bg but included) -->
    <stroke
        android:color="@color/theme"/>

    <!-- Rounded corners -->
    <corners android:radius="20dp"/>

</shape>
